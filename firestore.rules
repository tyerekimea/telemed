rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Marks who's allowed into /admin. You add yourself here manually in
    // the Firebase console — Document ID = your own Auth UID, no fields
    // needed. Nobody can write to this collection through the app.
    match /admins/{adminId} {
      allow read: if request.auth != null && request.auth.uid == adminId;
      allow write: if false;
    }

    // Each user can read their own profile (role, verified status); an
    // admin can read any profile, to review pending doctor signups.
    // Creation is allowed once, at signup. Updates are locked down except
    // for an admin flipping "verified" on a doctor's account.
    match /users/{userId} {
      allow read: if request.auth != null
        && (request.auth.uid == userId || isAdmin());
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["verified"]);
      allow delete: if false;
    }

    // Doctors list is public to read (patients need to browse it), locked to write.
    match /doctors/{doctorId} {
      allow read: if true;
      allow write: if false; // manage via Firebase console for now

      // Open slots: readable by anyone signed in; only the booking flow
      // (a signed-in user marking a slot booked) may update, never delete.
      match /slots/{slotId} {
        allow read: if request.auth != null;
        allow update: if request.auth != null
          && request.resource.data.booked == true
          && resource.data.booked == false;
        allow create, delete: if false; // seeded via admin script only
      }
    }

    // Appointments: a patient can create one for themselves. Reads are
    // scoped to whoever's actually involved — the booking patient or the
    // doctor whose uid matches doctorId (see the doctors collection note
    // above: doctor doc IDs = the doctor's own auth uid).
    match /appointments/{appointmentId} {
      allow create: if request.auth != null
        && request.resource.data.patientId == request.auth.uid;
      allow read: if request.auth != null
        && (resource.data.patientId == request.auth.uid
            || resource.data.doctorId == request.auth.uid);
      // Only the assigned doctor can update, and only the notes field —
      // status, patientId, doctorId, startTime etc. stay immutable here.
      allow update: if request.auth != null
        && resource.data.doctorId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["notes"]);
      allow delete: if false;
    }
  }
}

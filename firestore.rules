rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Marks who's allowed into /admin. You add yourself here manually in
    // the Firebase console — Document ID = your own Auth UID, no fields
    // needed. Nobody can write to this collection through the app.
    match /admins/{adminId} {
      allow read: if request.auth != null && request.auth.uid == adminId;
      allow write: if false;
    }

    // Each user can read their own profile (role, verified status); an
    // admin can read any profile, to review pending doctor signups.
    // Creation is allowed once, at signup. Updates: an admin can flip
    // "verified" on a doctor's account; a patient/doctor can fill in/edit
    // their own registration details — patient: name, DOB, phone, gender;
    // doctor: name, specialty, phone — plus profileComplete either way.
    // See app/patient/profile/page.js and app/doctor/profile/page.js.
    // Each is restricted to only its own set of fields.
    match /users/{userId} {
      allow read: if request.auth != null
        && (request.auth.uid == userId || isAdmin());
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null
        && ((isAdmin()
             && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["verified"]))
            || (request.auth.uid == userId
                && request.resource.data.diff(resource.data).affectedKeys()
                     .hasOnly(["firstName", "lastName", "dob", "phone", "gender", "specialty", "profileComplete"])));
      allow delete: if false;
    }

    // Doctors list is public to read (patients need to browse it). Writes
    // are admin-only now — approving a doctor in /admin auto-creates their
    // entry here (see app/admin/page.js), using their own uid as the
    // Document ID. No more manual Firestore step for this.
    match /doctors/{doctorId} {
      allow read: if true;
      allow write: if isAdmin();

      // Open slots: readable by anyone signed in. All writes — creating
      // availability and marking a slot booked — go exclusively through
      // the setDoctorAvailability / bookAppointment Cloud Functions
      // (functions/index.js), which run on the Admin SDK and are not
      // bound by these rules. No client write path is allowed here, so
      // a slot can't be marked booked (or created) without also going
      // through that functions' validation — verified-doctor checks,
      // transaction re-checks against double-booking, etc.
      match /slots/{slotId} {
        allow read: if request.auth != null;
        allow write: if false;
      }
    }

    // Appointments: created exclusively by the bookAppointment Cloud
    // Function (Admin SDK) — never directly by a client — so every
    // appointment is guaranteed to have gone through that function's
    // checks (verified doctor, real unbooked slot, matching startTime,
    // server-issued roomUrl). Reads are scoped to whoever's actually
    // involved — the booking patient or the doctor whose uid matches
    // doctorId (see the doctors collection note above: doctor doc IDs =
    // the doctor's own auth uid).
    match /appointments/{appointmentId} {
      allow create: if false;
      allow read: if request.auth != null
        && (resource.data.patientId == request.auth.uid
            || resource.data.doctorId == request.auth.uid);
      // Only the assigned doctor can update notes, prescription, or
      // investigation request (any subset — each has its own save
      // button); only the booking patient can update attachments. Each
      // is restricted to those fields — nobody can touch status,
      // patientId, doctorId, startTime, or the other party's fields
      // this way.
      allow update: if request.auth != null
        && ((resource.data.doctorId == request.auth.uid
             && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["notes", "prescription", "investigationRequest"]))
            || (resource.data.patientId == request.auth.uid
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["attachments"])));
      allow delete: if false;

      // Per-appointment chat, replacing Daily's built-in in-call chat (see
      // enable_chat: false in functions/index.js) — same access boundary
      // as the appointment and the call itself: only the patient or
      // doctor on this appointment. Messages are immutable once sent —
      // no edit, no delete — keeping this simple rather than building out
      // message moderation/edit history.
      match /messages/{messageId} {
        allow read: if request.auth != null
          && (get(/databases/$(database)/documents/appointments/$(appointmentId)).data.patientId == request.auth.uid
              || get(/databases/$(database)/documents/appointments/$(appointmentId)).data.doctorId == request.auth.uid);
        allow create: if request.auth != null
          && (get(/databases/$(database)/documents/appointments/$(appointmentId)).data.patientId == request.auth.uid
              || get(/databases/$(database)/documents/appointments/$(appointmentId)).data.doctorId == request.auth.uid)
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && request.resource.data.sentAt == request.time
          && request.resource.data.keys().hasOnly(["senderId", "text", "sentAt"]);
        allow update, delete: if false;
      }
    }
  }
}
